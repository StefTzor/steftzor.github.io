---
permalink: /admin/invites/
title: "Invites | Admin"
bodyScripts:
  - src: "/scripts/admin-invites.js"
    type: "module"
  - src: "/scripts/contact-widget.js"
    type: "module"
  - src: "/scripts/palette.js"
    type: "module"
---
<section class="app-page">
  <div class="app-prose">

  {% include "chrome/admin-sections.njk" %}

  <h1 class="text-3xl font-bold text-brand-text mb-2">Invites</h1>
  <p class="text-brand-muted mb-8">
    Creates an approved account and emails them a link to choose a password. They never need to
    register, and you never need to approve them afterwards.
  </p>

  <div id="status" role="status" aria-live="polite" class="mb-6 text-sm"></div>

  <form id="inviteForm" method="post" novalidate class="card">
    <div class="grid gap-4 sm:grid-cols-[1fr,auto] sm:items-end">
      <div>
        <label for="inviteEmail" class="field-label text-sm">Email address</label>
        <input spellcheck="false" type="email" id="inviteEmail" name="inviteEmail" required autocomplete="off" maxlength="254"
          aria-describedby="status"
          class="field">
      </div>
      <div>
        <label for="inviteRole" class="field-label text-sm">Role</label>
        <select id="inviteRole" name="inviteRole" class="field sm:w-auto">
          <option value="User">User</option>
          <option value="SuperUser">SuperUser</option>
          <option value="Admin">Admin</option>
        </select>
      </div>
    </div>

    {# Optional, and labelled as optional rather than merely left un-required: a field with no
       asterisk beside two that have one is a field people fill in because they assume they must.
       Whatever goes here is a starting point the invitee can change when they set their
       password - which is what the hint says, because a name someone else chose for you
       appearing in your account without explanation is worse than no name. #}
    <fieldset class="mt-5 border-t border-brand-muted/15 pt-5">
      <legend class="sr-only">Their name</legend>
      <p class="text-sm font-medium text-brand-text">Their name <span class="font-normal text-brand-muted">(optional)</span></p>
      <p class="hint mt-1 mb-3">
        A starting point only. They can change it, or fill it in themselves, when they choose
        their password.
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="inviteFirst" class="field-label text-sm">First name</label>
          <input type="text" id="inviteFirst" name="inviteFirst" autocomplete="off" maxlength="60"
            class="field">
        </div>
        <div>
          <label for="inviteLast" class="field-label text-sm">Last name</label>
          <input type="text" id="inviteLast" name="inviteLast" autocomplete="off" maxlength="60"
            class="field">
        </div>
      </div>
    </fieldset>

    <button type="submit" class="btn-primary mt-6 w-full sm:w-auto">Send invitation</button>
  </form>

  <p class="hint mt-4">
    An address that already has an account is refused rather than re-invited — look for it on
    <a href="/admin/" class="text-brand-accent underline hover:no-underline">Accounts</a>.
  </p>

</div>

</section>
