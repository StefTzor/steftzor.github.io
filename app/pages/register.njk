---
layout: app.njk
permalink: /register/
title: "Request an account | Stefanos Tzortzoglou"
bodyScripts:
  - src: "/scripts/auth.js"
    type: "module"
bodyClass: "bg-brand-bg text-brand-text antialiased min-h-screen flex flex-col"
---
<section class="container mx-auto px-4 py-16 max-w-md">
  <div class="bg-brand-surface p-8 rounded-lg shadow-md border border-brand-muted/10">
    <h1 class="text-2xl font-bold mb-2 text-brand-text">Request an account</h1>
    <p class="text-sm text-brand-muted mb-6">
      Accounts exist only to unlock a small private area. Every account is approved by hand, so
      you will not get access immediately.
    </p>

    <form id="registerForm" method="post" novalidate>
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div>
          <label for="firstName" class="block mb-1 font-medium text-brand-text">First name</label>
          <input type="text" id="firstName" name="firstName" required autocomplete="given-name" maxlength="60"
            aria-describedby="errorMsg"
            class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent aria-[invalid=true]:border-red-600">
        </div>
        <div>
          <label for="lastName" class="block mb-1 font-medium text-brand-text">Last name</label>
          <input type="text" id="lastName" name="lastName" required autocomplete="family-name" maxlength="60"
            aria-describedby="errorMsg"
            class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent aria-[invalid=true]:border-red-600">
        </div>
      </div>

      <div class="mb-4">
        <label for="email" class="block mb-1 font-medium text-brand-text">Email address</label>
        <input type="email" id="email" name="email" required autocomplete="email"
          aria-describedby="errorMsg"
          class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent aria-[invalid=true]:border-red-600">
      </div>

      <div class="mb-4">
        <label for="password" class="block mb-1 font-medium text-brand-text">Password</label>
        <input type="password" id="password" name="password" required autocomplete="new-password" minlength="8"
          aria-describedby="password-hint errorMsg"
          class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent aria-[invalid=true]:border-red-600">
        <p id="password-hint" class="mt-1 text-xs text-brand-muted">At least 8 characters.</p>
      </div>

      <div class="mb-6">
        <label for="confirmPassword" class="block mb-1 font-medium text-brand-text">Confirm password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password"
          aria-describedby="errorMsg"
          class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent aria-[invalid=true]:border-red-600">
      </div>

      <!-- GDPR Art. 6(1)(a) / Art. 7: consent must be a specific, informed, unticked opt-in. -->
      <div class="mb-6 flex items-start gap-3">
        <input type="checkbox" id="privacyConsent" name="privacyConsent" required
          class="mt-0.5 h-6 w-6 shrink-0 accent-brand-accent">
        <label for="privacyConsent" class="text-sm text-brand-muted leading-relaxed">
          I agree that my name, email address and account status may be stored so that this account can be created and
          manually approved, as described in the
          <a href="https://tzortzoglou.eu/privacy/" class="text-brand-accent underline hover:no-underline">Privacy Policy</a>.
          I accept the
          <a href="https://tzortzoglou.eu/terms/" class="text-brand-accent underline hover:no-underline">Terms of Use</a>.
          I can withdraw this consent and have the account deleted at any time by emailing
          <a href="mailto:stefanos@tzortzoglou.eu"
            class="text-brand-accent underline hover:no-underline">stefanos@tzortzoglou.eu</a>.
        </label>
      </div>

      <p class="mb-6 text-xs text-brand-muted">
        Your email is never used for marketing, never shared, and never sold.
      </p>

      <!-- Spam trap: hidden from people and from screen readers, irresistible to bots.
           Paired with a minimum fill time in auth.js. No third-party CAPTCHA, so no
           tracking is introduced and no visitor is asked to solve puzzles. -->
      <div class="hidden" aria-hidden="true">
        <label for="website">Leave this field empty</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
      </div>

      <div id="errorMsg" role="status" aria-live="polite" class="mb-4 text-sm text-red-700 dark:text-red-400"></div>

      <button type="submit" class="btn-primary w-full">Request account</button>
    </form>

    <p class="mt-6 text-sm text-brand-muted">
      Already have one?
      <a href="/login/" class="text-brand-accent underline hover:no-underline">Sign in</a>.
    </p>
  </div>
</section>
