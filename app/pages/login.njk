---
layout: app.njk
permalink: /login/
title: "Sign in | Stefanos Tzortzoglou"
bodyScripts:
  - src: "/scripts/auth.js"
    type: "module"
bodyClass: "bg-brand-bg text-brand-text antialiased min-h-screen flex flex-col"
redirectWhenAuthed: true
---
<section class="container mx-auto px-4 py-16 max-w-md">
  <div class="card p-8 shadow-md">
    <h1 class="text-2xl font-bold mb-6 text-brand-text">Sign in</h1>

    <form id="loginForm" method="post" novalidate>
      <div class="mb-4">
        <label for="email" class="field-label">Email address</label>
        <input type="email" id="email" name="email" required autocomplete="email"
          aria-describedby="errorMsg"
          class="field">
      </div>

      <div class="mb-2">
        <label for="password" class="field-label">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password"
          aria-describedby="errorMsg"
          class="field">
      </div>

      <p class="mb-6 text-sm">
        <a href="/reset/" class="text-brand-accent underline hover:no-underline">Forgotten your password?</a>
      </p>

      {# role="status" rather than alert: the handler moves focus to the field that needs
         fixing, so an assertive announcement would interrupt that rather than help it. #}
      <div id="errorMsg" role="status" aria-live="polite" class="mb-4 text-sm text-red-700 dark:text-red-400"></div>

      <button type="submit" class="btn-primary w-full">Sign in</button>
    </form>

    <p class="mt-6 text-sm text-brand-muted">
      No account yet?
      <a href="/register/" class="text-brand-accent underline hover:no-underline">Request one</a>.
      How your data is handled is in the
      <a href="https://tzortzoglou.eu/privacy/" class="text-brand-accent underline hover:no-underline">Privacy Policy</a>.
    </p>
  </div>
</section>
