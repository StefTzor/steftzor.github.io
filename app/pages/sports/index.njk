---
layout: app-shell.njk
permalink: /sports/
title: "Sports | Stefanos Tzortzoglou"
shell: true
bodyClass: "bg-brand-bg text-brand-text antialiased min-h-screen flex flex-col"
navDrawerOnly: true
signOut: true
bodyScripts:
  - src: "/scripts/sports.js"
    type: "module"
  - src: "/scripts/contact-widget.js"
    type: "module"
  - src: "/scripts/palette.js"
    type: "module"
---
{# The sports overview (api src/sports.js over src/leagues.js): a bulletin of stories written from
   the data and a few real headlines, the leagues, and every game this week. Favourites are team
   keys on the profile and come first wherever they appear. #}
<section class="app-page an-wrap">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="flex items-center gap-3 text-3xl font-bold text-brand-text">
        {% icon "fa-solid-futbol", "h-7 w-7 text-brand-accent" %}Sports
      </h1>
      <p class="mt-1 text-sm text-brand-muted">Allsvenskan, SHL and HockeyAllsvenskan.</p>
    </div>
    <nav aria-label="Leagues">
      <ul class="flex flex-wrap gap-2 text-sm">
        {%- for l in sportsLeagues %}
        <li><a href="/sports/{{ l.slug }}/" class="toc-link">{{ l.name }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>

  <div id="status" role="status" aria-live="polite" class="mb-4 text-sm"></div>

  {# --- bulletin: stories from the data on the left, headlines on the right. Reserved height, so
     the matches below do not move when it arrives. #}
  <div class="mb-6 grid gap-4 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <section class="card an-panel" aria-labelledby="spStoriesTitle">
      <h2 id="spStoriesTitle" class="an-panel-title">The big stories</h2>
      <ul id="spStories" class="mt-2 min-h-[14rem] space-y-1"></ul>
    </section>
    <section class="card an-panel" aria-labelledby="spNewsTitle">
      <div class="an-panel-head">
        <h2 id="spNewsTitle" class="an-panel-title">Headlines</h2>
        <span class="text-xs text-brand-muted">Expressen</span>
      </div>
      <ul id="spNews" class="mt-2 min-h-[14rem] space-y-2"></ul>
    </section>
  </div>

  <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-xl font-bold text-brand-text">This week</h2>
    <div class="flex flex-wrap items-center gap-2">
      <div class="an-tabs" role="tablist" aria-label="Sport">
        <button type="button" role="tab" class="an-tab" data-sport="all" aria-selected="true">All</button>
        <button type="button" role="tab" class="an-tab" data-sport="football" aria-selected="false" tabindex="-1">Football</button>
        <button type="button" role="tab" class="an-tab" data-sport="hockey" aria-selected="false" tabindex="-1">Hockey</button>
      </div>
      <button type="button" id="spFavOnly" class="btn-secondary px-3 py-1 text-xs" aria-pressed="false">Favourites only</button>
    </div>
  </div>
  <p id="spNote" class="mb-2 min-h-[1.25rem] text-xs text-brand-muted"></p>

  <div id="spDays" class="min-h-[28rem] space-y-4" aria-live="polite"></div>

  <details id="spPicker" class="card mt-6">
    <summary class="cursor-pointer font-semibold text-brand-text">
      Favourite teams <span id="spFavCount" class="text-sm font-normal text-brand-muted"></span>
    </summary>
    <p class="mt-2 text-sm text-brand-muted">Their games and stories come first and are highlighted, and "Favourites only" shows nothing else. Saved to your account.</p>
    <div id="spTeams" class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
    <div class="mt-4 flex items-center gap-3">
      <button type="button" id="spSave" class="btn-primary px-4 py-2 text-sm">Save favourites</button>
      <span id="spSaveNote" class="text-sm text-brand-muted" aria-live="polite"></span>
    </div>
  </details>

  <p class="mt-6 text-xs text-brand-muted">
    Fixtures, results and tables from ESPN, shl.se and hockeyallsvenskan.se; headlines from Expressen.
    Times are shown in your time zone.
  </p>
</section>
