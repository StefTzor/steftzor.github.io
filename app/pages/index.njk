---
layout: app-shell.njk
permalink: /
title: "Home | Stefanos Tzortzoglou"
bodyScripts:
  - src: "/scripts/app.js"
    type: "module"
bodyClass: "bg-brand-bg text-brand-text antialiased min-h-screen flex flex-col"
shell: true
navDrawerOnly: true
navItems:
  - label: "Home"
    href: "/"
    navKey: "home"
  - label: "Private"
    href: "/private/"
    navKey: "private"
    minRole: "SuperUser"
  - label: "Admin"
    href: "/admin/"
    navKey: "admin"
    minRole: "Admin"
signOut: true
---
<section class="container mx-auto px-4 py-10 max-w-3xl">

  {% include "chrome/weather-icons.njk" %}

  <h1 id="greeting" class="text-3xl font-bold mb-8 text-brand-text">&nbsp;</h1>

  <section aria-labelledby="weather-heading" class="card">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="weather-heading" class="text-lg font-bold text-brand-text">Weather</h2>
        <p id="weatherPlace" class="text-sm text-brand-muted mt-0.5"></p>
      </div>
      <p id="weatherClock" class="text-right text-sm text-brand-muted tabular-nums"></p>
    </div>

    {# One live region for the whole card: loading, the forecast, and any failure all land
       here, so a screen reader is told once rather than on every field. #}
    <div id="weather" role="status" aria-live="polite" class="mt-4">
      <p class="text-sm text-brand-muted">Loading the forecast…</p>
    </div>

    {# Shown only when the browser has the API, and never prompting on its own: an unexplained
       permission dialog on page load is the one thing everybody refuses out of reflex. The
       button says what it will do; the browser then asks. #}
    <div id="geo" class="mt-6 border-t border-brand-muted/15 pt-4 hidden">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p id="geoNote" class="text-xs text-brand-muted max-w-sm">
          Showing the forecast for a fixed location. Use your device's location for one nearer to you —
          it is sent rounded to about a kilometre, and never stored.
        </p>
        <button type="button" id="geoBtn" class="btn-secondary text-sm px-4 py-1.5 shrink-0">Use my location</button>
      </div>
    </div>
  </section>

</section>
