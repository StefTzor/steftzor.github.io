---
layout: app-shell.njk
permalink: /admin/
title: "Admin | Stefanos Tzortzoglou"
shell: true
bodyClass: "bg-brand-bg text-brand-text antialiased min-h-screen flex flex-col"
bodyScripts:
  - src: "/scripts/admin.js"
    type: "module"
navDrawerOnly: true
crossLink:
  label: "← tzortzoglou.eu"
  href: "https://tzortzoglou.eu/"
brandHref: "https://tzortzoglou.eu/"
navItems:
  - label: "Home"
    href: "/"
    navKey: "home"
  - label: "Private"
    href: "/private/"
    navKey: "private"
    minRole: "superuser"
  - label: "Admin"
    href: "/admin/"
    navKey: "admin"
    minRole: "admin"
signOut: true
---
<section class="container mx-auto px-4 py-10 max-w-4xl">

  <div class="flex items-baseline justify-between gap-4 mb-2">
    <h1 class="text-3xl font-bold text-brand-text">Accounts</h1>
    <p id="count" class="text-sm text-brand-muted"></p>
  </div>
  <p class="text-brand-muted mb-8">
    Approve who may sign in, and decide what each account can see.
  </p>

  {# One live region for every outcome. Actions here change what people can reach, so none of
     them may succeed silently - and a screen reader should hear the result once, not per row. #}
  <div id="status" role="status" aria-live="polite" class="mb-6 text-sm"></div>

  {# Rendered by admin.js: a table at sm and above, stacked cards below it. A wide table on a
     phone either overflows or becomes unreadable, and this one carries actions. #}
  <div id="accounts">
    <p class="text-sm text-brand-muted">Loading accounts…</p>
  </div>

  <section aria-labelledby="invite-heading"
    class="card mt-12">
    <h2 id="invite-heading" class="text-lg font-bold text-brand-text mb-1">Invite someone</h2>
    <p class="text-sm text-brand-muted mb-5">
      Creates an approved account and emails them a link to choose a password. They never need
      to register or wait.
    </p>

    <form id="inviteForm" method="post" novalidate class="grid gap-3 sm:grid-cols-[1fr,auto,auto] sm:items-end">
      <div>
        <label for="inviteEmail" class="field-label text-sm">Email address</label>
        <input type="email" id="inviteEmail" name="inviteEmail" required autocomplete="off" maxlength="254"
          aria-describedby="status"
          class="field">
      </div>
      <div>
        <label for="inviteRole" class="field-label text-sm">Role</label>
        <select id="inviteRole" name="inviteRole"
          class="field sm:w-auto">
          <option value="user">user</option>
          <option value="superuser">superuser</option>
          <option value="admin">admin</option>
        </select>
      </div>
      <button type="submit" class="btn-primary w-full sm:w-auto">Send invitation</button>
    </form>
  </section>

</section>
