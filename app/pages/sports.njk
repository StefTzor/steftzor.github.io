---
layout: app-shell.njk
permalink: /sports/
title: "Matches | Stefanos Tzortzoglou"
shell: true
bodyClass: "bg-brand-bg text-brand-text antialiased min-h-screen flex flex-col"
navDrawerOnly: true
signOut: true
bodyScripts:
  - src: "/scripts/sports.js"
    type: "module"
  - src: "/scripts/contact-widget.js"
    type: "module"
  - src: "/scripts/palette.js"
    type: "module"
---
{# Matches from today to a week ahead (api src/sports.js, TheSportsDB). Favourites are team ids
   on the profile, so they follow the account rather than the browser. Leagues come from the
   API's list; nothing here names one, so adding a country is an API change only. #}
<section class="app-page an-wrap">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="flex items-center gap-3 text-3xl font-bold text-brand-text">
        {% icon "fa-solid-futbol", "h-7 w-7 text-brand-accent" %}Matches
      </h1>
      <p id="spLeagues" class="mt-1 text-sm text-brand-muted">Today to a week ahead.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <div class="an-tabs" role="tablist" aria-label="Sport">
        <button type="button" role="tab" class="an-tab" data-sport="all" aria-selected="true">All</button>
        <button type="button" role="tab" class="an-tab" data-sport="football" aria-selected="false" tabindex="-1">Football</button>
        <button type="button" role="tab" class="an-tab" data-sport="hockey" aria-selected="false" tabindex="-1">Hockey</button>
      </div>
      <button type="button" id="spFavOnly" class="btn-secondary px-3 py-1 text-xs" aria-pressed="false">Favourites only</button>
    </div>
  </div>

  <div id="status" role="status" aria-live="polite" class="mb-4 text-sm"></div>
  <p id="spNote" class="mb-4 min-h-[1.25rem] text-xs text-brand-muted"></p>

  {# Reserves roughly a week of rows, so the list arriving does not move the favourites below. #}
  <div id="spDays" class="min-h-[28rem] space-y-4" aria-live="polite"></div>

  <details id="spPicker" class="card mt-6">
    <summary class="cursor-pointer font-semibold text-brand-text">
      Favourite teams <span id="spFavCount" class="text-sm font-normal text-brand-muted"></span>
    </summary>
    <p class="mt-2 text-sm text-brand-muted">Their matches are highlighted, and "Favourites only" shows nothing else. Saved to your account.</p>
    <div id="spTeams" class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
    <div class="mt-4 flex items-center gap-3">
      <button type="button" id="spSave" class="btn-primary px-4 py-2 text-sm">Save favourites</button>
      <span id="spSaveNote" class="text-sm text-brand-muted" aria-live="polite"></span>
    </div>
  </details>

  <p class="mt-6 text-xs text-brand-muted">Fixtures from TheSportsDB. Times are shown in your time zone.</p>
</section>
