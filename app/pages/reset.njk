---
layout: app-shell.njk
permalink: /reset/
title: "Reset your password | Stefanos Tzortzoglou"
bodyScripts:
  - src: "/scripts/auth.js"
    type: "module"
bodyClass: "bg-brand-bg text-brand-text antialiased min-h-screen flex flex-col"
---
{# Centred in what is left of the viewport under the bar, rather than pinned to the top
   with the rest of the screen empty beneath it. #}
<section class="container mx-auto px-4 py-10 max-w-md min-h-[calc(100vh-12rem)] flex flex-col justify-center">
  <div class="card p-8 shadow-md">
    <h1 class="text-2xl font-bold mb-2 text-brand-text">Reset your password</h1>
    <p class="text-sm text-brand-muted mb-6">
      Enter your email address and we will send a link to choose a new password. The link works
      once and expires shortly.
    </p>

    <form id="resetForm" method="post" novalidate>
      <div class="mb-6">
        <label for="email" class="field-label">Email address</label>
        <input type="email" id="email" name="email" required autocomplete="email"
          aria-describedby="errorMsg"
          class="field">
      </div>

      <div id="errorMsg" role="status" aria-live="polite" class="mb-4 text-sm text-red-700 dark:text-red-400"></div>

      <button type="submit" class="btn-primary w-full">Send reset link</button>
    </form>

    <p class="mt-6 text-sm text-brand-muted">
      <a href="/login/" class="text-brand-accent underline hover:no-underline">Back to sign in</a>
    </p>
  </div>
</section>
