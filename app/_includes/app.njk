<!DOCTYPE html>
{#
  Layout for app.tzortzoglou.eu.

  This does NOT reuse _includes/base.njk, on purpose. That layout is three quarters SEO
  contract - canonical, hreflang, Open Graph, Twitter, JSON-LD, the indexable collection -
  and every page here is behind a login and must never be indexed at all. Parameterising
  base.njk to switch off most of itself would couple two things that are diverging.

  What genuinely must not drift is shared instead of copied: the stylesheet, the fonts and
  the cache-busting and CSP transforms all come from eleventy.common.js.

  Front matter:
    title        the <title>
    bodyClass    classes on <body>
    redirectWhenAuthed  send an already-signed-in visitor to the app home
    shell        render the signed-in header and role-driven navigation
    inlineScript end-of-body script
    pageStyle    inline <style> for this page
    bodyScripts  [{src, type, integrity, defer}] loaded at end of body
#}
<html lang="en" class="scroll-smooth dark">

<head>
  <meta charset="UTF-8">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  {# Must stay before the stylesheet, or the wrong theme paints first. Byte-identical to the
     public site's copy so both pages hash to the same CSP value. #}
  <script>(function(){try{var t=localStorage.getItem('theme');document.documentElement.classList[t==='light'?'remove':'add']('dark');}catch(e){}})();</script>
  <link rel="preload" href="/fonts/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/poppins-700-latin.woff2" as="font" type="font/woff2" crossorigin>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# Nothing here is for the public. The app is also excluded in robots.txt, but a header
     that only applies to pages nobody can reach is not much of a defence - this is. #}
  <meta name="robots" content="noindex, nofollow">
  <title>{{ title }}</title>

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#cbd5e1" media="(prefers-color-scheme: light)">

  <link href="/dist/output.css" rel="stylesheet">
  {%- if pageStyle %}
  {# Inline rather than a stylesheet: it is one page's worth of CSS, and the CSP transform
     hashes it automatically, so there is nothing to keep in sync. #}
  <style>
{{ pageStyle | safe }}
  </style>
  {%- endif %}
</head>

<body{% if redirectWhenAuthed %} data-redirect-when-authed="1"{% endif %} class="{{ bodyClass | default('bg-brand-bg text-brand-text antialiased min-h-screen flex flex-col') }}">

  <a href="#main-content" class="skip-link">Skip to content</a>

  {%- if shell %}
  {# The signed-in chrome.
     A sidebar rather than a top bar: the app's sections are a short, stable list that should
     stay visible while you work, and a vertical list has room to label them properly and to
     carry a second group - the way back to the public site, which a horizontal bar would have
     had to hide behind a menu.

     Below lg it collapses to a top bar with a disclosure. The nav then expands in normal flow
     rather than as an overlay, which means no focus trap to get wrong and no way to tab into
     something invisible: the links are either in the document or they are not.

     It stays hidden until /me answers, so the nav never shows a link the viewer cannot use. #}
  <div class="lg:flex lg:min-h-screen">

    <header id="appHeader" class="hidden lg:w-60 lg:shrink-0 lg:border-r border-b lg:border-b-0 border-brand-muted/15 bg-brand-surface lg:min-h-screen">
      <div class="lg:sticky lg:top-0">

        <div class="flex items-center justify-between gap-2 px-4 py-3 lg:py-5">
          <div class="min-w-0">
            <p class="font-bold text-brand-text leading-tight truncate">Stefanos Tzortzoglou</p>
            <p id="whoami" class="text-xs text-brand-muted truncate"></p>
          </div>
          {# Only ever visible below lg; aria-expanded is the state, the class is the paint. #}
          <button type="button" id="navToggle" aria-expanded="false" aria-controls="navPanel"
            class="lg:hidden shrink-0 rounded border border-brand-muted/30 px-3 py-2 text-sm text-brand-text">
            <span class="sr-only">Show navigation</span>
            <span aria-hidden="true">☰</span>
          </button>
        </div>

        <div id="navPanel" class="hidden lg:block pb-4">
          <nav aria-label="Application" class="px-2">
            <ul class="space-y-1">
              <li><a href="/" data-nav="home" class="block rounded px-3 py-2 text-sm text-brand-text hover:bg-brand-bg">Home</a></li>
              <li class="hidden" data-min-role="superuser"><a href="/private/" data-nav="private" class="block rounded px-3 py-2 text-sm text-brand-text hover:bg-brand-bg">Private</a></li>
              <li class="hidden" data-min-role="admin"><a href="/admin/" data-nav="admin" class="block rounded px-3 py-2 text-sm text-brand-text hover:bg-brand-bg">Admin</a></li>
            </ul>
          </nav>

          <nav aria-labelledby="site-nav-label" class="px-2 mt-6">
            <p id="site-nav-label" class="px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-brand-muted">tzortzoglou.eu</p>
            <ul class="space-y-1">
              <li><a href="https://tzortzoglou.eu/" class="block rounded px-3 py-2 text-sm text-brand-muted hover:bg-brand-bg hover:text-brand-text">Home</a></li>
              <li><a href="https://tzortzoglou.eu/about/" class="block rounded px-3 py-2 text-sm text-brand-muted hover:bg-brand-bg hover:text-brand-text">About</a></li>
              <li><a href="https://tzortzoglou.eu/portfolio/" class="block rounded px-3 py-2 text-sm text-brand-muted hover:bg-brand-bg hover:text-brand-text">Portfolio</a></li>
              <li><a href="https://tzortzoglou.eu/code/" class="block rounded px-3 py-2 text-sm text-brand-muted hover:bg-brand-bg hover:text-brand-text">Code</a></li>
              <li><a href="https://tzortzoglou.eu/contact/" class="block rounded px-3 py-2 text-sm text-brand-muted hover:bg-brand-bg hover:text-brand-text">Contact</a></li>
            </ul>
          </nav>

          <div class="px-4 mt-6">
            <button type="button" data-logout class="btn-secondary w-full text-sm py-2">Sign out</button>
          </div>
        </div>

      </div>
    </header>
  {%- endif %}

  {%- if shell %}
    <main id="main-content" class="flex-grow min-w-0" aria-busy="true">
      {{ content | safe }}
    </main>
  </div>
  {%- else %}
  <main id="main-content" class="flex-grow">
    {{ content | safe }}
  </main>
  {%- endif %}

  {%- if shell %}
  {# The narrow-screen disclosure, deliberately NOT in shell.js.
     That module imports the Firebase SDK from gstatic; if that request fails - a blocked CDN, a
     flaky network, a corporate proxy - the module never executes, and a toggle living inside it
     would be dead while the nav it controls stayed hidden. This is presentation, it depends on
     nothing, and the CSP transform hashes it automatically.

     The panel expands in normal flow rather than as an overlay, so there is no focus to trap:
     `hidden` takes the links out of the layout and out of the tab order together. #}
  <script>
    (function () {
      var toggle = document.getElementById('navToggle');
      var panel = document.getElementById('navPanel');
      if (!toggle || !panel) return;
      toggle.addEventListener('click', function () {
        var open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        panel.classList.toggle('hidden', open);
        toggle.querySelector('.sr-only').textContent = open ? 'Show navigation' : 'Hide navigation';
      });
    })();
  </script>
  {%- endif %}
  {%- for s in bodyScripts %}
  {# Literal src="..." with double quotes - the cachebust transform only versions that shape. #}
  <script{% if s.type %} type="{{ s.type }}"{% endif %} src="{{ s.src }}"{% if s.integrity %} integrity="{{ s.integrity }}" crossorigin="anonymous" referrerpolicy="no-referrer"{% endif %}{% if s.defer %} defer{% endif %}></script>
  {%- endfor %}
  {%- if inlineScript %}
  <script>
{{ inlineScript | safe }}
  </script>
  {%- endif %}
</body>

</html>
