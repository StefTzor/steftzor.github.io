# The image builds from source; none of this belongs in the build context.
node_modules
_site
_app
dist
.git
.github
graphify-out
.remember
*.test.js
# Local tooling and anything holding credentials. Nothing here reaches the final image today -
# it copies only _app - but a build context should not carry what it has no use for.
.claude
.agents
skills-lock.json
.env
.env.*
ignore
firestore.rules
.firebaserc
