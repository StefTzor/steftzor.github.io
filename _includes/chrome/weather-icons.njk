{#
  Weather glyphs as an inline SVG sprite.

  A sprite rather than icons built in JavaScript, because the forecast is upstream data and
  app.js renders it with createElement and textContent throughout - never innerHTML. The shapes
  are ours and fixed, so they belong in the markup; the script only points a <use> at one of
  them by id, and can therefore never turn a weather code into markup.

  Stroke rather than fill, and currentColor throughout, so they inherit the text colour and work
  unchanged in both themes.
#}
<svg width="0" height="0" class="hidden" aria-hidden="true" focusable="false">
  <defs>
    <g id="wx-base" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></g>
  </defs>

  <symbol id="wx-clear" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2"/>
    <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"/>
  </symbol>

  <symbol id="wx-night" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4 8.3 8.3 0 1 0 20 14.5z"/>
  </symbol>

  <symbol id="wx-partly" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="8.5" cy="8" r="3"/>
    <path d="M8.5 2.6v1.6M3.1 8h1.6M4.7 4.2l1.1 1.1M12.3 4.2l-1.1 1.1"/>
    <path d="M9 19h8.2a3.4 3.4 0 0 0 .3-6.8 4.8 4.8 0 0 0-9.2-.9A3.6 3.6 0 0 0 9 19z"/>
  </symbol>

  <symbol id="wx-cloud" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 19h10.2a3.6 3.6 0 0 0 .3-7.2 5.2 5.2 0 0 0-10-1A3.8 3.8 0 0 0 7 19z"/>
  </symbol>

  <symbol id="wx-fog" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 14.5h10.2a3.6 3.6 0 0 0 .3-7.2 5.2 5.2 0 0 0-10-1A3.8 3.8 0 0 0 7 14.5z"/>
    <path d="M4.5 18h15M7 21h11"/>
  </symbol>

  <symbol id="wx-drizzle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 15h10.2a3.6 3.6 0 0 0 .3-7.2 5.2 5.2 0 0 0-10-1A3.8 3.8 0 0 0 7 15z"/>
    <path d="M9 18.5v1.4M13 18.5v1.4M17 18.5v1.4"/>
  </symbol>

  <symbol id="wx-rain" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 14.5h10.2a3.6 3.6 0 0 0 .3-7.2 5.2 5.2 0 0 0-10-1A3.8 3.8 0 0 0 7 14.5z"/>
    <path d="M9 17.5l-1 3.2M13 17.5l-1 3.2M17 17.5l-1 3.2"/>
  </symbol>

  <symbol id="wx-snow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 14.5h10.2a3.6 3.6 0 0 0 .3-7.2 5.2 5.2 0 0 0-10-1A3.8 3.8 0 0 0 7 14.5z"/>
    <path d="M9 18.2v2.6M7.8 18.9l2.4 1.2M10.2 18.9l-2.4 1.2M15 18.2v2.6M13.8 18.9l2.4 1.2M16.2 18.9l-2.4 1.2"/>
  </symbol>

  <symbol id="wx-thunder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 14h10.2a3.6 3.6 0 0 0 .3-7.2 5.2 5.2 0 0 0-10-1A3.8 3.8 0 0 0 7 14z"/>
    <path d="M13 16.2l-2.6 3.6h3l-2.2 3"/>
  </symbol>
</svg>
