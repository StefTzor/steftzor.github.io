{#
  The one footer, used by tzortzoglou.eu and by app.tzortzoglou.eu.

  The app used to get a cut-down version of this - wordmark, four legal links, copyright - on the
  theory that a signed-in area has no use for a marketing footer. That was the wrong theory: it
  made the bottom of the page announce which of the two properties you were on, right after the
  top of the page had been made to stop doing exactly that. Same footer, both places.

  Front matter:
    siteBase  "" on tzortzoglou.eu, "https://tzortzoglou.eu" on the app. Everything here points
              at the public site, which is where all of it lives, so the app needs absolute URLs
              and the site must not have them - a same-origin link that goes out and comes back
              is a needless round trip and breaks the view transition.
#}
{# `chrome-dark` for the same reason as the bar: the footer is chrome, so it keeps the dark
   palette in both themes. Light mode used to end on the same colour the page was already, which
   left the bottom of every page with no edge at all. In dark mode the class is a no-op. #}
<footer class="chrome-dark bg-brand-bg border-t border-brand-border py-12 mt-auto">
  <div class="container mx-auto text-center px-4">
    {#- One blue, as in the header, and for the same reason: this wordmark is on dark in both
        themes now, and blue-700 on #0f172a is 2.7:1 against blue-400's 7.0:1. -#}
    <h2 class="text-2xl font-bold inline-block">
      <a href="{{ siteBase }}/"
        class="bg-gradient-to-r from-brand-accent to-blue-400 bg-clip-text text-transparent inline-block hover:-translate-y-1 transition-transform duration-300">
        Stefanos Tzortzoglou
      </a>
    </h2>
    <p lang="el" class="mt-1 text-sm font-light tracking-wide text-brand-muted max-w-md mx-auto">Στέφανος
      Τζώρτζογλου</p>
    <p class="mt-2 text-brand-muted max-w-md mx-auto">Technical Customer Success Manager</p>
    <p class="mt-1 text-brand-muted max-w-md mx-auto">Enterprise SaaS onboarding & implementation | Stockholm</p>

    <div class="mt-6 flex justify-center space-x-6">
      <a href="https://github.com/steftzor" target="_blank" rel="noopener noreferrer"
        class="text-brand-text hover:text-brand-accent transition-transform hover:-translate-y-1">
        {% icon "fa-brands-github", "text-2xl" %}
        <span class="sr-only">GitHub profile (opens in a new tab)</span>
      </a>
      <a href="https://www.linkedin.com/in/stzortzoglou/" target="_blank" rel="noopener noreferrer"
        class="text-brand-text hover:text-brand-accent transition-transform hover:-translate-y-1">
        {% icon "fa-brands-linkedin", "text-2xl" %}
        <span class="sr-only">LinkedIn profile (opens in a new tab)</span>
      </a>
      <a href="mailto:stefanos@tzortzoglou.eu"
        class="text-brand-text hover:text-brand-accent transition-transform hover:-translate-y-1">
        {% icon "fa-solid-envelope", "text-2xl" %}
        <span class="sr-only">Email Stefanos Tzortzoglou</span>
      </a>
    </div>

    {# The live status badge. Without script it is a plain link to /status/; scripts/chrome.js
       fills it in from the API's /status once the footer scrolls into view, so a reader who
       never reaches the footer sends nothing. #}
    <a id="stBadge" href="{{ siteBase }}/status/" class="st-badge" data-state="loading">
      <span class="st-pulse" aria-hidden="true"></span>
      <span class="grid text-left leading-tight">
        <span id="stBadgeTitle" class="text-sm font-semibold text-brand-text">System status</span>
        <span id="stBadgeMeta" class="text-xs text-brand-muted tabular-nums">Live checks of the site, app and API</span>
      </span>
      <span id="stBadgeStrip" class="st-mini" aria-hidden="true"></span>
    </a>

    <nav aria-label="Legal" class="mt-8">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <li><a href="{{ siteBase }}/privacy/" class="text-brand-muted hover:text-brand-accent underline">Privacy Policy</a></li>
        <li><a href="{{ siteBase }}/cookies/" class="text-brand-muted hover:text-brand-accent underline">Cookies &amp; Local
            Storage</a></li>
        <li><a href="{{ siteBase }}/terms/" class="text-brand-muted hover:text-brand-accent underline">Terms of Use</a></li>
        <li><a href="{{ siteBase }}/accessibility/" class="text-brand-muted hover:text-brand-accent underline">Accessibility</a></li>      </ul>
    </nav>

    {# Site operator / data controller identity (GDPR Art. 13(1)(a)). It belongs on the app at
       least as much as on the site: the app is where the personal data actually is. #}
    <address class="mt-6 text-xs text-brand-muted not-italic leading-relaxed">
      Operated as a personal portfolio by <strong>Stefanos Tzortzoglou</strong>, a private individual based in
      Uppsala, Sweden.<br>
      Not a registered company. No goods or services are sold through this site.<br>
      Contact: <a href="mailto:stefanos@tzortzoglou.eu"
        class="underline hover:text-brand-accent">stefanos@tzortzoglou.eu</a>
    </address>

    <p class="mt-6 text-xs text-brand-muted uppercase tracking-widest">&copy; <span id="footer-year">2026</span>
      Stefanos Tzortzoglou. All rights reserved.</p>
  </div>
</footer>
