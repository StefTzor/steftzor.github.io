{#
  The app's footer. Deliberately not the marketing one.

  It exists for a specific reason: the app is where personal data is actually processed, and
  until now /privacy/, /terms/ and /cookies/ were unreachable from any page of it. A person
  being asked to create an account should never have to go looking for what happens to it.
#}
<footer class="border-t border-brand-muted/10 py-8 mt-auto">
  <div class="container mx-auto px-4 text-center">
    <a href="https://tzortzoglou.eu/"
      class="bg-gradient-to-r from-brand-accent to-blue-700 dark:to-blue-400 bg-clip-text text-transparent font-bold inline-block">
      Stefanos Tzortzoglou
    </a>
    <nav aria-label="Legal" class="mt-4">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <li><a href="https://tzortzoglou.eu/privacy/" class="text-brand-muted hover:text-brand-accent underline">Privacy Policy</a></li>
        <li><a href="https://tzortzoglou.eu/cookies/" class="text-brand-muted hover:text-brand-accent underline">Cookies &amp; Local Storage</a></li>
        <li><a href="https://tzortzoglou.eu/terms/" class="text-brand-muted hover:text-brand-accent underline">Terms of Use</a></li>
        <li><a href="https://tzortzoglou.eu/accessibility/" class="text-brand-muted hover:text-brand-accent underline">Accessibility</a></li>
      </ul>
    </nav>
    <p class="mt-6 text-xs text-brand-muted uppercase tracking-widest">
      &copy; <span id="footer-year">2026</span> Stefanos Tzortzoglou
    </p>
  </div>
</footer>
