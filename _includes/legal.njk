<!DOCTYPE html>
{#- `dark` is on <html> here for the same reason it is on base.njk, app-shell.njk and
    redirect.njk: chrome/theme-boot.njk only ever REMOVES the class, when the stored theme is
    light. It never adds it. A layout that starts without it is therefore light for everybody,
    whatever they chose - which is what these four pages did, so a reader in dark mode clicking
    Privacy got a white page. -#}
<html lang="en" class="scroll-smooth dark">

<head>
  <meta charset="UTF-8">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  {% include "chrome/theme-boot.njk" %}
  <link rel="preload" href="/fonts/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/poppins-700-latin.woff2" as="font" type="font/woff2" crossorigin>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="https://tzortzoglou.eu{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="https://tzortzoglou.eu{{ page.url }}">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">

  <!-- Open Graph / social sharing -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Stefanos Tzortzoglou">
  <meta property="og:locale" content="en_US">
  <meta property="og:locale:alternate" content="el_GR">
  <meta property="og:url" content="https://tzortzoglou.eu{{ page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://tzortzoglou.eu/images/og-cover.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Stefanos Tzortzoglou — Technical Customer Success Manager. Enterprise SaaS onboarding, SQL, REST APIs, CDP and CRM/ERP integrations.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://tzortzoglou.eu/images/og-cover.png">
  <meta name="twitter:image:alt" content="Stefanos Tzortzoglou — Technical Customer Success Manager, enterprise SaaS onboarding and implementation.">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ title | jsonInScript | safe }},
    "description": {{ description | jsonInScript | safe }},
    "url": "https://tzortzoglou.eu{{ page.url }}",
    "dateModified": "{{ buildDateTime }}",
    "inLanguage": "en",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://tzortzoglou.eu",
      "name": "Stefanos Tzortzoglou"
    },
    "publisher": {
      "@type": "Person",
      "name": "Stefanos Tzortzoglou",
      "url": "https://tzortzoglou.eu"
    }
  }
  </script>

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="manifest" href="/site.webmanifest">
  {# One value, not a pair. The browser's own chrome should match the top of the page, and the
     top of the page is the header, which carries `chrome-dark` and is this navy in both themes.
     A light-scheme value here would draw a pale strip directly above a dark bar. #}
  <meta name="theme-color" content="#0f172a">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <link href="/dist/output.css" rel="stylesheet">

</head>

<body class="bg-brand-bg text-brand-text antialiased transition-colors duration-300 flex flex-col min-h-screen">

  {% include "chrome/header.njk" %}

  <main id="main-content" class="flex-grow container mx-auto py-16 px-4">
    <div class="max-w-3xl mx-auto legal">

      <h1 class="text-4xl md:text-5xl font-bold text-brand-text mb-4">{{ heading }}</h1>
      <p class="text-sm text-brand-muted mb-2">
        Last updated: <time datetime="{{ updated }}">{{ updatedLabel }}</time>
      </p>
      {% if summary %}
      <p class="text-lg text-brand-muted border-l-4 border-brand-accent pl-4 py-1 mb-10">{{ summary }}</p>
      {% endif %}

      {{ content | safe }}

      <hr class="my-12 border-brand-border">
      <p class="text-sm">
        Questions about this page? Email
        <a href="mailto:stefanos@tzortzoglou.eu">stefanos@tzortzoglou.eu</a>.
      </p>
    </div>
  </main>

  {% include "chrome/footer.njk" %}

  {# The chrome both properties share; see scripts/chrome.js. #}
  <script src="/scripts/chrome.js"></script>
  <script src="/scripts/consent.js"></script>
</body>

</html>
