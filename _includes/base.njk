<!DOCTYPE html>
{#
  Base layout for the standalone pages.

  The SEO head is a contract (references/seo-invariants.md) and it used to be maintained by
  hand in nine files, which is how three pages ended up telling Google they were /about/.
  It lives here now so it cannot drift again.

  11ty layouts are inclusion, not inheritance - there is no {% block %} to override - so every
  page-specific part arrives as front matter. All of it is optional; a page that needs nothing
  declares nothing:

    title, description   the <title>, meta description, OG and Twitter text
    noindex: true        robots noindex, and skips canonical/hreflang/OG/Twitter entirely
    personSchema: true   emits the shared Person schema from _data/schema.js
    profilePage: true    wraps that Person in a ProfilePage with dateModified (homepage)
    jsonLd: []           further schema.org objects, dumped as JSON (escaping handled here)
    headPreconnect: []   extra preconnect hosts, for assets only this page loads
    headStyles: []       extra stylesheets; emitted BEFORE pageStyle so a page can override them
    pageStyle            inline <style> for this page
    headScripts: []      synchronous head scripts, each {src, integrity}
    bodyScripts: []      extra end-of-body scripts, each {src, type, integrity}
    authRequired: true   page has auth UI, so Firebase loads unconditionally
    mainClass            classes on <main>
#}
<html lang="en" class="scroll-smooth dark">

<head>
  <meta charset="UTF-8">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  {# Must stay here, before the stylesheet, or the wrong theme paints first. #}
  <script>(function(){try{var t=localStorage.getItem('theme');document.documentElement.classList[t==='light'?'remove':'add']('dark');}catch(e){}})();</script>
  {# The two weights used above the fold. Without these the fallback paints first and Poppins
     swaps in with different metrics, reflowing the headings and pushing everything below them
     down - which was almost all of this site's layout shift. #}
  <link rel="preload" href="/fonts/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/poppins-700-latin.woff2" as="font" type="font/woff2" crossorigin>
  {%- for host in headPreconnect %}
  <link rel="preconnect" href="{{ host }}">
  {%- endfor %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- if noindex %}
  <meta name="robots" content="noindex, follow">
  {%- else %}
  <link rel="canonical" href="https://tzortzoglou.eu{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="https://tzortzoglou.eu{{ page.url }}">
  {%- endif %}
  <title>{{ title }}</title>
  {%- if description %}
  <meta name="description" content="{{ description }}">
  {%- endif %}
{% if not noindex %}
  <!-- Open Graph / social sharing -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Stefanos Tzortzoglou">
  <meta property="og:locale" content="en_US">
  <meta property="og:locale:alternate" content="el_GR">
  <meta property="og:url" content="https://tzortzoglou.eu{{ page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://tzortzoglou.eu{{ ogImage | default('/images/og-cover.png') }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Stefanos Tzortzoglou — Technical Customer Success Manager and Implementation Lead. SQL, APIs, Data Strategy, Enterprise SaaS.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://tzortzoglou.eu{{ ogImage | default('/images/og-cover.png') }}">
  <meta name="twitter:image:alt" content="Stefanos Tzortzoglou — Technical Customer Success Manager and Implementation Lead.">
{% endif %}
  {%- if personSchema %}
  {# One copy, in _data/schema.js. It used to be pasted into four pages, which is
     how they all ended up claiming the same mainEntityOfPage. #}
  <script type="application/ld+json">{{ schema.personStandalone | forPage(page.url) | dump | safe }}</script>
  {%- endif %}
  {%- if profilePage %}
  {# The homepage wraps the same Person in a ProfilePage carrying the build time.
     dateModified cannot live in front matter - Eleventy does not template it. #}
  <script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "ProfilePage", "dateModified": buildDateTime, "mainEntity": schema.person | forPage(page.url) } | dump | safe }}</script>
  {%- endif %}
  {%- for schema in jsonLd %}
  {# dump handles the escaping - titles here contain ampersands. #}
  <script type="application/ld+json">{{ schema | dump | safe }}</script>
  {%- endfor %}

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#cbd5e1" media="(prefers-color-scheme: light)">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <link href="/dist/output.css" rel="stylesheet">
  {%- for sheet in headStyles %}
  <link rel="stylesheet" href="{{ sheet.href }}"{% if sheet.integrity %} integrity="{{ sheet.integrity }}" crossorigin="anonymous" referrerpolicy="no-referrer"{% endif %}>
  {%- endfor %}
  {%- for s in headScripts %}
  {# Synchronous on purpose where a page's inline caller runs before DOMContentLoaded. #}
  <script src="{{ s.src }}"{% if s.integrity %} integrity="{{ s.integrity }}" crossorigin="anonymous" referrerpolicy="no-referrer"{% endif %}></script>
  {%- endfor %}
  {%- if pageStyle %}
  <style>
{{ pageStyle | safe }}
  </style>
  {%- endif %}
</head>

<body{% if authRequired %} data-auth="required"{% endif %} class="bg-brand-bg text-brand-text antialiased transition-colors duration-300 flex flex-col min-h-screen">

  {% include "chrome/header.njk" %}

  <main id="main-content" class="{{ mainClass | default('flex-grow container mx-auto py-16 px-4') }}">
    {{ content | safe }}
  </main>

  {% include "footer.html" %}

  {# The chrome both properties share; see scripts/chrome.js. #}
  <script src="/scripts/chrome.js"></script>
  {# Loads Firebase only where it is needed; see scripts/auth-boot.js. #}
  <script src="/scripts/auth-boot.js"></script>
  <script src="/scripts/consent.js"></script>
  {%- for s in bodyScripts %}
  {# Literal src="..." with double quotes - the cachebust transform in .eleventy.js
     only versions that exact shape. #}
  <script{% if s.type %} type="{{ s.type }}"{% endif %} src="{{ s.src }}"{% if s.integrity %} integrity="{{ s.integrity }}" crossorigin="anonymous" referrerpolicy="no-referrer"{% endif %}></script>
  {%- endfor %}
  {%- if inlineScript %}
  <script>
{{ inlineScript | safe }}
  </script>
  {%- endif %}
</body>

</html>
