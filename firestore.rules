rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = the site owner. Console → Authentication → Users for the UID.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'ckn2vJRf4uTXkZbuvxwY4cX2dO22';
    }

    match /users/{userId} {
      // Names are shown in the admin list and used to greet the person, so the client writes
      // them - but the client is not trusted about their shape. A missing name is allowed (the
      // older sign-up form does not collect one); a 500-character one is not.
      function okName(field) {
        return !(field in request.resource.data)
          || (request.resource.data[field] is string && request.resource.data[field].size() <= 60);
      }

      // Read own doc; admin can read anyone's.
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Create ONLY your own doc, ONLY as "pending" — blocks self-approval at signup.
      // hasOnly is the line that stops a client writing its own `role`: adding a key here is
      // adding something the browser may set about itself, so it is never a routine edit.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && okName('firstName') && okName('lastName')
        && request.resource.data.keys().hasOnly(
             ['email', 'firstName', 'lastName', 'status', 'createdAt', 'consentAt']);

      // Only the admin (site owner) can approve / change status.
      allow update: if isAdmin();

      // No client-side deletes.
      allow delete: if false;
    }

    // Lock everything else down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
