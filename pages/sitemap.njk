---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
{#- Generated from the `indexable` collection in .eleventy.js, the same source the IndexNow
    list uses, so adding a page registers it in both or in neither. The two lists used to be
    maintained by hand and the SEO reference names their drift as the commonest regression here. #}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in collections.indexable %}
    <url>
        <loc>https://tzortzoglou.eu{{ page.url }}</loc>
        <lastmod>{{ buildDate }}</lastmod>
        <changefreq>{{ page.data.sitemapChangefreq | default("monthly") }}</changefreq>
        <priority>{{ page.data.sitemapPriority | default("0.5") }}</priority>
    </url>
{%- endfor %}
</urlset>
