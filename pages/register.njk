<!DOCTYPE html>
<html lang="en" class="dark">

<head>
  <meta charset="UTF-8">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <script>(function(){try{var t=localStorage.getItem('theme');document.documentElement.classList[t==='light'?'remove':'add']('dark');}catch(e){}})();</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, follow">
  <title>Create an account - Stefanos Tzortzoglou</title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#cbd5e1" media="(prefers-color-scheme: light)">

  <link href="/dist/output.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous"
    referrerpolicy="no-referrer">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-brand-bg text-brand-text antialiased transition-colors duration-300 flex flex-col min-h-screen">
  <!-- Header -->
  {% include "_includes/header.html" %}

  <main id="main-content" class="flex-grow container mx-auto py-16 px-4">
    <section class="max-w-md mx-auto bg-brand-surface p-8 rounded-lg shadow-md border border-brand-muted/10">
      <h1 class="text-2xl font-bold mb-2 text-brand-text">Create an account</h1>
      <p class="text-sm text-brand-muted mb-6">
        Accounts exist only to unlock a small private area of this site. Every account is approved manually, so you will
        not get access immediately.
      </p>

      <form id="registerForm">
        <div class="mb-4">
          <label for="email" class="block mb-1 font-medium text-brand-text">Email address</label>
          <input type="email" id="email" name="email" required autocomplete="email"
            class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent">
        </div>

        <div class="mb-4">
          <label for="password" class="block mb-1 font-medium text-brand-text">Password</label>
          <input type="password" id="password" name="password" required autocomplete="new-password" minlength="8"
            aria-describedby="password-hint"
            class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent">
          <p id="password-hint" class="mt-1 text-xs text-brand-muted">At least 8 characters.</p>
        </div>

        <div class="mb-6">
          <label for="confirmPassword" class="block mb-1 font-medium text-brand-text">Confirm password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password"
            class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent">
        </div>

        <!-- GDPR Art. 6(1)(a) / Art. 7: consent must be a specific, informed, unticked opt-in. -->
        <div class="mb-6 flex items-start gap-3">
          <input type="checkbox" id="privacyConsent" name="privacyConsent" required
            class="mt-1 h-4 w-4 shrink-0 accent-brand-accent">
          <label for="privacyConsent" class="text-sm text-brand-muted leading-relaxed">
            I agree that my email address and account status may be stored so that this account can be created and
            manually approved, as described in the
            <a href="/privacy/" class="text-brand-accent underline hover:no-underline">Privacy Policy</a>. I accept the
            <a href="/terms/" class="text-brand-accent underline hover:no-underline">Terms of Use</a>.
            I can withdraw this consent and have the account deleted at any time by emailing
            <a href="mailto:stefanos@tzortzoglou.eu"
              class="text-brand-accent underline hover:no-underline">stefanos@tzortzoglou.eu</a>.
          </label>
        </div>

        <p class="mb-6 text-xs text-brand-muted">
          Your email is never used for marketing, never shared, and never sold.
        </p>

        <!-- Spam trap: hidden from people and from screen readers, irresistible to bots.
             Paired with a minimum fill time in auth.js. No third-party CAPTCHA, so no
             tracking is introduced and no visitor is asked to solve puzzles. -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
        </div>

        <!-- role="status" so both errors and the success message are announced, without hijacking focus. -->
        <div id="errorMsg" role="status" aria-live="polite" class="mb-4 text-sm text-red-700 dark:text-red-400"></div>

        <button type="submit" class="btn-primary w-full">Create account</button>
      </form>

      <p class="mt-6 text-sm text-brand-muted">
        Already have an account?
        <a href="/login/" class="text-brand-accent underline hover:no-underline">Log in</a>.
      </p>
    </section>
  </main>

  <!-- Footer -->
  {% include "_includes/footer.html" %}

  <!-- Scripts -->
  <script type="module" src="/scripts/firebase-config.js"></script>
  <script type="module" src="/scripts/auth.js"></script>
  <script src="/scripts/main.js"></script>
  <script src="/scripts/consent.js"></script>
</body>

</html>
