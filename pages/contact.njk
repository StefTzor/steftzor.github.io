<body class="bg-brand-bg text-brand-text transition-colors duration-300 flex flex-col min-h-screen">

    {% include "_includes/header.html" %}

    <main id="main-content" class="flex-grow container mx-auto px-4 flex items-center justify-center">

        <div class="max-w-2xl w-full py-16">

            <div class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-bold mb-6">Get in <span
                        class="text-brand-accent">Touch</span></h1>
                <p class="text-xl text-brand-muted leading-relaxed">
                    I am a Technical Customer Success Manager at Data Talks, leading enterprise implementations.
                    Email, LinkedIn and the form below all reach me directly, and I answer every message myself.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">

                <a href="mailto:stefanos@tzortzoglou.eu"
                    class="group bg-brand-surface p-8 rounded-2xl border border-brand-muted/10 hover:border-brand-accent/50 hover:shadow-glow transition-all duration-300 text-center">
                    <div
                        class="w-16 h-16 bg-brand-accent/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-brand-accent group-hover:text-white group-hover:-translate-y-2 transition-all duration-300">
                        <i class="fas fa-envelope text-2xl text-brand-accent group-hover:text-white" aria-hidden="true"></i>
                    </div>

                    <h2 class="text-xl font-bold mb-2">Email Me</h2>
                    <p class="text-brand-muted text-sm mb-4">Best for anything that needs more than a paragraph.</p>
                    <span class="text-brand-accent font-medium group-hover:underline">stefanos@tzortzoglou.eu</span>
                </a>

                <a href="https://www.linkedin.com/in/stzortzoglou/" target="_blank"
                    class="group bg-brand-surface p-8 rounded-2xl border border-brand-muted/10 hover:border-[#0077b5]/50 hover:shadow-lg transition-all duration-300 text-center" rel="noopener noreferrer">
                    <div
                        class="w-16 h-16 bg-[#0077b5]/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-[#0077b5] group-hover:text-white group-hover:-translate-y-2 transition-all duration-300">
                        <i class="fab fa-linkedin-in text-2xl text-[#0077b5] group-hover:text-white" aria-hidden="true"></i>
                    </div>

                    <h2 class="text-xl font-bold mb-2">Connect on LinkedIn</h2>
                    <p class="text-brand-muted text-sm mb-4">Full work history, and where I am easiest to reach for a quick
                        message.</p>
                    <span class="text-[#0077b5] font-medium group-hover:underline">View Profile</span>
                </a>

            </div>

            <div class="bg-brand-surface p-8 rounded-2xl border border-brand-muted/10 mb-12">
      <h2 class="text-2xl font-bold mb-2">Or write to me here</h2>
      <p class="text-brand-muted text-sm mb-6">
        Write as much or as little as you like. I reply from <strong>stefanos@tzortzoglou.eu</strong>.
      </p>

      <form id="contactForm" novalidate>
        <div class="mb-4">
          <label for="contactName" class="block mb-1 font-medium text-brand-text">Your name</label>
          <input type="text" id="contactName" name="name" required maxlength="100" autocomplete="name"
            class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent">
        </div>

        <div class="mb-4">
          <label for="contactEmail" class="block mb-1 font-medium text-brand-text">Your email address</label>
          <input type="email" id="contactEmail" name="email" required maxlength="254" autocomplete="email"
            aria-describedby="contactEmail-hint"
            class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent">
          <p id="contactEmail-hint" class="mt-1 text-xs text-brand-muted">So I can reply. Nothing else.</p>
        </div>

        <div class="mb-6">
          <label for="contactMessage" class="block mb-1 font-medium text-brand-text">Message</label>
          <textarea id="contactMessage" name="message" required minlength="10" maxlength="5000" rows="6"
            class="w-full p-2 rounded bg-brand-bg text-brand-text border border-brand-muted/40 focus:border-brand-accent"></textarea>
        </div>

        <!-- GDPR Art. 6(1)(a) / Art. 7: consent must be a specific, informed, unticked opt-in. -->
        <div class="mb-6 flex items-start gap-3">
          <input type="checkbox" id="contactConsent" name="contactConsent" required
            class="mt-1 h-4 w-4 shrink-0 accent-brand-accent">
          <label for="contactConsent" class="text-sm text-brand-muted leading-relaxed">
            I agree that my name, email address and message may be stored and emailed to Stefanos so that he can
            reply, as described in the
            <a href="/privacy/" class="text-brand-accent underline hover:no-underline">Privacy Policy</a>.
            I can ask for the message to be deleted at any time by emailing
            <a href="mailto:stefanos@tzortzoglou.eu"
              class="text-brand-accent underline hover:no-underline">stefanos@tzortzoglou.eu</a>.
          </label>
        </div>

        <p class="mb-6 text-xs text-brand-muted">
          Your details are never used for marketing, never added to a mailing list, never shared, and never sold.
          Please do not send anything confidential. Ordinary email is not end-to-end encrypted.
        </p>

        <!-- Spam trap: hidden from people and from screen readers, irresistible to bots.
             Paired with a minimum fill time in contact.js. No third-party CAPTCHA, so no
             tracking is introduced and no visitor is asked to solve puzzles. -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
        </div>

        <!-- role="status" so both errors and the success message are announced, without hijacking focus. -->
        <div id="contactStatus" role="status" aria-live="polite" class="mb-4 text-sm"></div>

        <button type="submit" id="contactSubmit" class="btn-primary w-full">Send message</button>
      </form>
    </div>

    <div class="bg-brand-surface/50 rounded-lg p-4 text-center border border-brand-muted/10 max-w-md mx-auto">
                <div
                    class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 text-brand-muted text-sm">

                    <div class="flex items-center gap-2">
                        <span class="relative flex h-3 w-3">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                        </span>
                        <span>Based in <strong>Uppsala, Sweden</strong></span>
                    </div>

                    <span class="hidden sm:inline text-brand-muted/30">|</span>

                    <span>Working in <strong>Stockholm</strong></span>

                </div>
            </div>

        </div>

    </main>

